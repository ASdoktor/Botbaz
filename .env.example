# ============================================
# 🤖 AUTO ALERT BOT - KONFIGURACE
# ============================================

# 🔐 TELEGRAM
# Jak získat TELEGRAM_BOT_TOKEN:
#   1. Napiš @BotFather v Telegramu
#   2. Napiš /newbot
#   3. Zadej jméno a username bota
#   4. Dostaneš token → zkopíruj níže
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabc_XYZ

# Jak získat TELEGRAM_ADMIN_ID:
#   1. Napiš @userinfobot v Telegramu
#   2. Zobrazí ti tvoje User ID
TELEGRAM_ADMIN_ID=123456789

# Jak získat TELEGRAM_GROUP_ID:
#   1. Vytvoř novou Supergroup v Telegramu ("Auto Alerty")
#   2. Přidej bota do skupiny
#   3. Napiš /start do skupiny
#   4. Bot vypíše Group ID (bude záporné)
#   5. Nebo zkopíruj z linku na skupinu
TELEGRAM_GROUP_ID=-1001234567890

# ============================================

# 🗄️  DATABÁZE
# Výběr:
#   SQLite (jednoduchý, bez instalace):
#     DATABASE_URL=sqlite:///bazos_bot.db
#   
#   PostgreSQL (profesionální, vyžaduje server):
#     DATABASE_URL=postgresql://user:heslo@localhost:5432/bazos_bot_db

DATABASE_URL=sqlite:///bazos_bot.db

# ============================================

# ⏱️  SCRAPER
# Jak často (v minutách) scrapovat Bazoš
SCRAPER_INTERVAL_MINUTES=5

# Kolik stránek Bazoše scrapovat (každá má ~20 inzerátů)
MAX_PAGES_TO_SCRAPE=3

# ============================================

# 🐛 DEBUG
DEBUG=False
LOG_LEVEL=INFO
